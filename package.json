{
  "name": "the-flying-dutchman",
  "private": true,
  "version": "1.0.0",
  "description": "WISPBOUND: a monochrome Game Boy-style RPG, with a 1-4 player co-op roguelike mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "sim": "tsx sim/sim.ts",
    "server": "tsx server/server.ts",
    "host": "npm run build && tsx server/server.ts",
    "start": "tsx server/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "phaser": "3.80.1",
    "tsx": "4.19.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
