# Copy to .env (or set in your static host's build settings) ONLY when the game is hosted
# somewhere other than the multiplayer server, e.g. on itch.io or Netlify. Leave it unset
# when Render serves the game itself: the game then connects to the server it came from.
# Accepts https://..., wss://... or a bare host name.
VITE_ROGUE_SERVER=https://wispbound.onrender.com
